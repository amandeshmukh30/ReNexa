# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# ── Virtual Environment ────────────────────
venv/
env/
.venv/

# ── Environment Variables / Secrets ────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Test Caches & Artifacts ────────────────
.pytest_cache/
runs/
scratch/

# ── IDE ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ────────────────────────────────
.ipynb_checkpoints/

# ── Raw Datasets ───────────────────────────
# Large raw datasets should NOT be uploaded to GitHub
data/raw/*
!data/raw/.gitkeep

# ── Processed Datasets ─────────────────────
# Large processed training datasets should NOT be uploaded
data/processed/renexa_detection_final/
data/processed/renexa_detection/
data/processed/renexa_classification/
data/processed/renexa_attributes/

# ── Keep Processed Reports ─────────────────
# Reports and dataset documentation SHOULD be uploaded
!data/processed/reports/
!data/processed/reports/**

# ── Keep Dataset Configuration Files ───────
!data/processed/**/*.yaml
!data/processed/**/*.yml

# ── Knowledge Base ─────────────────────────
# ReNexa recovery knowledge and safety rules SHOULD be uploaded
!data/knowledge/
!data/knowledge/**

# ── ML Models ──────────────────────────────
# Trained model files are too large for normal GitHub
*.pt
*.pth
*.onnx

# ── Training Outputs ───────────────────────
training/runs/
training/outputs/
training/checkpoints/

# ── Runtime Generated Data ─────────────────
# User scan/history/recommendation data is generated locally
data/runtime/*.json
data/evaluation/*.json

# ── Streamlit ──────────────────────────────
# Keep .streamlit/config.toml