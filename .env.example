# ==============================================================================
# ReNexa — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env with real credentials or secrets to version control.
# ==============================================================================

# Supabase Cloud Database Configuration (Phase 9A)
# Leave empty to automatically use local file-based fallback storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Direct PostgreSQL Connection String (if connecting directly)
DATABASE_URL=

# Streamlit App Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
